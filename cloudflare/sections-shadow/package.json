{
  "name": "@nw/sections-shadow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run typecheck && npm test && npm run deploy:check",
    "deploy:check": "wrangler deploy --dry-run --outdir dist --experimental-auto-create=false",
    "activate:prepare": "node scripts/activate-production.mjs --prepare-only",
    "activate:production": "node scripts/activate-production.mjs",
    "smoke:production": "node scripts/activate-production.mjs --smoke-only",
    "dev": "wrangler dev",
    "migrate:local": "wrangler d1 migrations apply nw-sections-shadow --local",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types"
  },
  "devDependencies": {
    "@cloudflare/playwright": "^1.3.6",
    "@cloudflare/vitest-plugin": "1.1.0",
    "@types/node": "^22.15.17",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.126.0"
  }
}
